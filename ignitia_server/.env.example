# Copy this file to .env and adjust values. All values are optional
# (sane defaults are compiled into app/config.py).

# --- Server ---
# Host/port used by `python run.py`
HOST=0.0.0.0
PORT=86

# --- Security ---
# Secret used to sign JWT tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in hours
JWT_EXPIRE_HOURS=720

# --- Office geo-fence (server side, authoritative) ---
# Coordinates of the office centre and allowed radius in metres.
# The Flutter client's placeholder values live in lib/config/office_location_config.dart
# (23.810331, 90.412521, 300 m) - mirror or override them here.
OFFICE_LATITUDE=23.810331
OFFICE_LONGITUDE=90.412521
OFFICE_RADIUS_METERS=300

# --- Attendance policy ---
# Office in/out times (24h). Used for late_duration and overtimE_MINUTES.
OFFICE_START_TIME=09:00
OFFICE_END_TIME=18:00
# Cut-off: after this hour a check-in is recorded as a missing check-in day.
# Leave empty to disable.

# --- Face verification ---
# Similarity threshold 0..1 for the perceptual-hash fallback.
FACE_SIMILARITY_THRESHOLD=0.72
# When the SFace embedding models below are available, face verification uses
# embedding cosine similarity with this threshold instead.
FACE_EMBEDDING_THRESHOLD=0.363
FACE_DETECTOR_MODEL=app/data/face_detection_yunet.onnx
FACE_EMBEDDING_MODEL=app/data/face_recognition_sface.onnx
# Directory where submitted face snapshots are stored.
UPLOAD_DIR=uploads/faces

# --- Liveness (blink challenge) frame validation ---
# When true, check-in / check-out WITHOUT liveness frames is rejected.
LIVENESS_REQUIRED=false
# Minimum number of live frames the client must submit.
MIN_LIVENESS_FRAMES=3
# At least one consecutive frame pair must differ by this fraction of average
# pixel intensity (0..1) to prove motion, not a replayed still image.
LIVENESS_MIN_DIVERSITY=0.03
# Fresh single-use challenges must accompany the frames (anti-replay). TTL for
# each issued challenge before it expires.
LIVENESS_CHALLENGE_TTL_SECONDS=60

# --- Database ---
DATABASE_URL=sqlite:///./ignitia.db

# --- Password reset email (optional) ---
# Leave SMTP_* empty to write the reset link to the server log only (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ignitia.local
# Reset link validity window
RESET_TOKEN_TTL_MINUTES=30

# --- Google SSO via Supabase (shared project, web + Android) ---
# Supabase Project URL + anon key + JWT secret from Supabase Dashboard → Project Settings → API.
# Leave empty to disable SSO (POST /api/Login/supabase returns 503).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=<jwt-secret>
# Flutter clients receive these via --dart-define (see docs/google-sso.md):
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
SUPABASE_URL=
SUPABASE_JWT_SECRET=
